# Copia este fichero como .env y rellena los valores reales.
# Nunca subas .env a Git.

# Clave secreta para las sesiones y el CSRF (pon cualquier texto largo y aleatorio)
SECRET_KEY=cambia-esto-por-algo-secreto

# URL de conexión a MySQL de XAMPP
# Formato: mysql+pymysql://usuario:contrasena@host:puerto/nombre_base_datos
DATABASE_URL=mysql+pymysql://root:@localhost:3306/rutacompartida

# Clave de Google Maps (se añade en la tarea 2.1)
GOOGLE_MAPS_KEY=
